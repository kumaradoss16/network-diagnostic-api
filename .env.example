# Copy this file to .env and adjust as needed.
# All variables have sensible defaults (see app/core/config.py) — you only
# need a .env file if you want to override them for local development.

# --- App metadata ---
APP_NAME=Network Diagnostic API
APP_VERSION=1.0.0
ENVIRONMENT=development

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Logging ---
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of allowed origins, or "*" to allow all.
CORS_ORIGINS=*

# --- Security ---
# Set to true when exposing this API publicly, to reject diagnostic
# targets that resolve to private/loopback/reserved addresses.
BLOCK_PRIVATE_TARGETS=false

# --- Diagnostic hard caps (enforced regardless of what a caller requests) ---
MAX_PING_COUNT=10
MAX_TIMEOUT_SECONDS=10
